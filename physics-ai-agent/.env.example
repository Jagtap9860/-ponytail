# Copy to .env and fill in. Never commit real keys.
# LLM provider selection: echo | openai_compatible
PHYSICS_AGENT_LLM_PROVIDER=echo
PHYSICS_AGENT_LLM_MODEL=echo-1
# OpenAI-compatible endpoint (OpenAI, vLLM, Ollama, LM Studio, ...).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
# Default explanation level: 1=beginner, 2=undergrad, 3=advanced, 4=research
PHYSICS_AGENT_LEVEL=2
# Default interaction mode: direct | guided | teaching | exam | research | engineering
PHYSICS_AGENT_MODE=direct
